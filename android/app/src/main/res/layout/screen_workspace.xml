<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ig_bg">

    <WebView
        android:id="@+id/workspaceWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:id="@+id/workspaceLoadingBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:contentDescription="@string/brand_logo_description"
            android:src="@drawable/ig_official_app_icon"/>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/workspaceLoading"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="14dp"
            app:indicatorColor="@color/ig_cyan"
            app:trackColor="@color/ig_surface_2"/>
    </LinearLayout>
</FrameLayout>
