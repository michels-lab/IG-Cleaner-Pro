<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/workspaceSyncProgress"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:visibility="gone"
        app:indicatorColor="@color/ig_cyan"
        app:trackColor="@color/ig_canvas"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="15dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/mobileWorkspaceEyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INSTAGRAM CLEANER PRO"
            android:textColor="@color/ig_cyan"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"/>

        <TextView
            android:id="@+id/mobileWorkspaceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Home"
            android:textColor="@color/ig_text"
            android:textSize="27sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"/>

        <TextView
            android:id="@+id/mobileWorkspaceSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Restoring your synced workspace…"
            android:textColor="@color/ig_muted"
            android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/homeKpis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                app:cardBackgroundColor="@color/ig_surface"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/ig_border"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="14dp">
                    <TextView android:id="@+id/homeReviewCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textAppearance="@style/TextAppearance.IGC.Kpi"/>
                    <TextView android:id="@+id/homeReviewLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="REVIEW PENDING" android:textAppearance="@style/TextAppearance.IGC.Micro"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                app:cardBackgroundColor="@color/ig_surface"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/ig_border"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="14dp">
                    <TextView android:id="@+id/homeMutualCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textAppearance="@style/TextAppearance.IGC.Kpi" android:textColor="@color/ig_cyan"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="MUTUALS" android:textAppearance="@style/TextAppearance.IGC.Micro"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                app:cardBackgroundColor="@color/ig_surface"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/ig_border"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="14dp">
                    <TextView android:id="@+id/homeFollowerCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/ig_text" android:textSize="21sp" android:textStyle="bold" android:fontFamily="monospace"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="FOLLOWERS" android:textAppearance="@style/TextAppearance.IGC.Micro"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                app:cardBackgroundColor="@color/ig_surface"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/ig_border"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="14dp">
                    <TextView android:id="@+id/homePendingCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/ig_gold" android:textSize="21sp" android:textStyle="bold" android:fontFamily="monospace"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="REQUESTS" android:textAppearance="@style/TextAppearance.IGC.Micro"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/reviewTabsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/workspaceTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabReview"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Not following back"
                android:textAllCaps="false"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabMutuals"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Mutuals"
                android:textAllCaps="false"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabFollowers"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Followers"
                android:textAllCaps="false"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabPending"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Requests"
                android:textAllCaps="false"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/sectionKpis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            app:cardBackgroundColor="@color/ig_surface"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/ig_border"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="14dp">
                <TextView android:id="@+id/kpiMain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textAppearance="@style/TextAppearance.IGC.Kpi"/>
                <TextView android:id="@+id/kpiMainLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="PRIMARY" android:textAppearance="@style/TextAppearance.IGC.Micro"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            app:cardBackgroundColor="@color/ig_surface"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/ig_border"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="14dp">
                <TextView android:id="@+id/kpiSecondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textAppearance="@style/TextAppearance.IGC.Kpi" android:textColor="@color/ig_cyan"/>
                <TextView android:id="@+id/kpiSecondaryLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="SECONDARY" android:textAppearance="@style/TextAppearance.IGC.Micro"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/workspaceSearchLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="12dp"
        android:hint="Search profile"
        android:visibility="gone"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxStrokeColor="@color/ig_border"
        app:startIconDrawable="@android:drawable/ic_menu_search">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/workspaceSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/ig_text"/>
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">
        <TextView
            android:id="@+id/workspaceSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Continue review"
            android:textColor="@color/ig_text"
            android:textSize="18sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/workspaceSectionSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/ig_muted"
            android:textSize="11sp"/>
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/workspaceRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/workspaceProfileList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="20dp"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>