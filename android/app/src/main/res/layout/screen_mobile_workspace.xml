<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ig_bg"
    android:paddingHorizontal="16dp">

    <TextView
        android:id="@+id/mobileWorkspaceTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Tu Instagram"
        android:textColor="@color/ig_text"
        android:textSize="26sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/mobileWorkspaceSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Cargando datos sincronizados…"
        android:textColor="@color/ig_muted"
        android:textSize="13sp"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:scrollbars="none">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/workspaceTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabReview"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Review"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabMutuals"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mutuals"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabFollowers"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Followers"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tabPending"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardBackgroundColor="@color/ig_surface"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/ig_border"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView android:id="@+id/kpiMain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/ig_text" android:textSize="26sp" android:textStyle="bold"/>
                <TextView android:id="@+id/kpiMainLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pendientes" android:textColor="@color/ig_muted" android:textSize="11sp" android:textAllCaps="true"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:cardBackgroundColor="@color/ig_surface"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/ig_border"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView android:id="@+id/kpiSecondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/ig_text" android:textSize="26sp" android:textStyle="bold"/>
                <TextView android:id="@+id/kpiSecondaryLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total" android:textColor="@color/ig_muted" android:textSize="11sp" android:textAllCaps="true"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <TextView
        android:id="@+id/workspaceSectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Pendientes de revisar"
        android:textColor="@color/ig_text"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/workspaceSectionSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Toca un perfil para abrir Instagram."
        android:textColor="@color/ig_muted"
        android:textSize="12sp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/workspaceProfileList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/openAdvancedWorkspace"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Herramientas avanzadas"/>
</LinearLayout>