<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/ig_surface"
    app:cardCornerRadius="18dp"
    app:strokeColor="@color/ig_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/profileCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:buttonTint="@color/ig_cyan"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView android:id="@+id/profileUsername" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ig_text" android:textSize="16sp"/>
            <TextView android:id="@+id/profileDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/ig_muted" android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/profileBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp"
            android:textColor="@color/ig_cyan"
            android:textSize="10sp"
            android:textStyle="bold"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
