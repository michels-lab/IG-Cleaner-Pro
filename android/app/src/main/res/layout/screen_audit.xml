<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/auditTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Audit"
        android:textColor="@color/ig_text"
        android:textSize="28sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/auditSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Vuelve a abrir perfiles revisados desde Desktop o Android sin modificar su revisión original."
        android:textColor="@color/ig_muted"
        android:textSize="14sp"/>

    <LinearLayout
        android:id="@+id/auditQuickActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/auditAndroidReviewed"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="20 revisados Android"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/auditDesktopReviewed"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="20 revisados PC"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/auditAndroidOpened"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="20 abiertos Android"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/auditDesktopOpened"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="20 abiertos PC"/>
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/auditList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/finishAudit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Marcar auditoría completada"
        android:visibility="gone"/>
</LinearLayout>
